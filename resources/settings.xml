        <setting id="discovery_de_username" type="text" label="Username" default="" enable="eq(-2,true)" />
        <setting id="discovery_de_password" type="text" label="Password" option="hidden" default="" enable="eq(-3,true)" />
        <setting id="discovery_de_proxy_enabled" type="bool" label="Enable Proxy" default="false" enable="eq(-4,true)" />
        <setting id="discovery_de_proxy_host" type="text" label="Proxy Host" default="" visible="eq(-1,true)" />
        <setting id="discovery_de_proxy_port" type="number" label="Proxy Port" default="8080" visible="eq(-2,true)" />
    </category>

