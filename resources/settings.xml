<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<settings>
    <!-- =============================================== -->
    <!-- GENERAL SETTINGS                               -->
    <!-- =============================================== -->
    <category label="General">
        <setting id="server_port" type="number" label="Server Port" default="7777">
            <level>0</level>
            <help>Port number for the Ultimate Backend service</help>
        </setting>

        <setting id="epg_xml_url" type="text" label="EPG XML URL" default="https://example.com/epg.xml.gz">
            <level>0</level>
            <help>URL to download XMLTV EPG data. Can be .xml or .xml.gz format.</help>
        </setting>

        <setting id="default_country" type="labelenum" label="Default Country" values="DE|AT|CH|EU|HR|PL|ME|HU|BA|GLOBAL" default="DE">
            <level>0</level>
            <help>Default country code for providers that support multiple countries</help>
        </setting>

        <setting id="default_provider_enabled" type="enum" label="Default for New Providers" values="Disabled|Enabled" default="Disabled">
            <level>1</level>
            <help>Default enabled state for providers not explicitly configured. Disabled is recommended to avoid unexpected channels.</help>
        </setting>

        <setting id="epg_clear_cache" type="action" label="Clear EPG Cache">
            <level>2</level>
            <help>Force clear EPG cache and re-download on next request</help>
        </setting>
    </category>

    <!-- =============================================== -->
    <!-- DISCOVERY+                                      -->
